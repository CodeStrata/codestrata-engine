    "findings": ["cve::cve-2026-9999::pkg-b"]
  },
  "controlled_rerun_source": {
    "description": "Candidate source evaluated against base feed (isolates source)",
    "source_digest": "sha256:source_v2",
    "feed_digest": "sha256:feed_v1",
    "findings": []
  },
  "controlled_rerun_feed": {
    "description": "Base source evaluated against candidate feed (isolates feed)",
    "source_digest": "sha256:source_v1",
    "feed_digest": "sha256:feed_v2",
    "findings": [
      "cve::cve-2025-1001::pkg-a",
      "cve::cve-2026-9999::pkg-b"
