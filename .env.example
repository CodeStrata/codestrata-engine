# CodeStrata environment variables
#
# Copy to `.env` in the project root (or any parent of the working directory).
# CodeStrata loads `.env` automatically when reading configuration. Existing shell
# environment variables always win over `.env` values.
#
# Never commit a real `.env` file.

# --- Logging ---
CODESTRATA_LOG_LEVEL=WARNING
CODESTRATA_LOG_FORMAT=text

# --- Execution profile (Phase 5.20) ---
# Allowed: community | local | enterprise | bedrock | openai
# Precedence: CLI --profile > this variable > codestrata.toml > profile defaults
# CODESTRATA_PROFILE=community

# --- Private GitHub HTTPS clones ---
# Reference this name from codestrata.toml: [repository.authentication] token_env = "CODESTRATA_GITHUB_TOKEN"
# CODESTRATA_GITHUB_TOKEN=

# --- Optional AI-enhanced assessment (Amazon Bedrock) ---
# Uses the standard AWS credential provider chain. Prefer env vars on each machine:
# AWS_PROFILE=my-profile
# AWS_REGION=us-east-1
# CODESTRATA_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Do not commit developer-specific AWS profile names in codestrata.toml.

# --- Optional OpenAI knowledge providers (profile = "openai") ---
# Only the *name* of the env var is stored in codestrata.toml ([ai.openai].api_key_env).
# OPENAI_API_KEY=
# Optional override for that env-var name:
# CODESTRATA_OPENAI_API_KEY_ENV=OPENAI_API_KEY

# --- Optional PMD override (Java static analysis) ---
# CODESTRATA_PMD_PATH=/opt/homebrew/bin/pmd

# --- Repository Knowledge vector store (Phase 5.4.1) ---
# Default: in-memory (zero setup, non-persistent).
CODESTRATA_VECTOR_STORE_PROVIDER=memory

# Enable for Docker Compose or hosted PostgreSQL + pgvector:
# CODESTRATA_VECTOR_STORE_PROVIDER=pgvector
# Local Docker example credentials are for developer use only — never use in production:
# CODESTRATA_DATABASE_URL=postgresql://codestrata:codestrata@localhost:5432/codestrata
# CODESTRATA_DATABASE_SCHEMA=codestrata

# Deprecated Phase 5.4 alias (prefer CODESTRATA_DATABASE_URL):
# CODESTRATA_PGVECTOR_URL=
