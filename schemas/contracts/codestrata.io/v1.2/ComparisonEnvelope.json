{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codestrata.io/schemas/contracts/v1.2/ComparisonEnvelope.json",
  "title": "CodeStrata Engine Comparison Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "envelope_digest", "has_baseline", "compatibility", "compatibility_reasons", "movement", "cause_attribution", "candidate", "coverage_status"],
  "properties": {
    "schema_name": { "type": "string", "const": "codestrata.comparison-envelope.v1" },
    "schema_version": { "type": "string" },
    "envelope_digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "has_baseline": { "type": "boolean" },
    "compatibility": { "type": "string", "enum": ["compatible", "incompatible", "no_baseline", "unknown"] },
    "compatibility_reasons": { "type": "array" },
    "movement": { "type": "string" },
    "cause_attribution": { "type": "string", "enum": ["source_only", "feed_only", "configuration_only", "mixed", "undetermined"] },
    "changed_input_dimensions": { "type": "array" },
    "controlled_equivalent_inputs": { "type": "boolean" },
    "baseline": { "type": ["object", "null"] },
    "candidate": { "type": "object", "additionalProperties": false },
    "driver_deltas": { "type": "array" },
    "retained_known_violation_ids": { "type": "array" },
    "excluded_driver_ids": { "type": "array" },
    "coverage_status": { "type": "string" },
    "notes": { "type": "array" }
  }
}
