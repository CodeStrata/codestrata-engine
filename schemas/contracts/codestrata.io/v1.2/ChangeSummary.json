{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codestrata.io/schemas/contracts/v1.2/ChangeSummary.json",
  "title": "CodeStrata Engine M27/M29 Change Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "changed_file_ids",
    "changed_component_ids",
    "changed_file_count",
    "changed_component_count",
    "unmapped_changed_file_count",
    "mapping_coverage_status",
    "boundary_spread_status",
    "crossed_boundary_status",
    "graph_side"
  ],
  "properties": {
    "schema_name": { "type": "string" },
    "schema_version": { "type": "string" },
    "changed_file_ids": { "type": "array" },
    "changed_component_ids": { "type": "array" },
    "changed_file_count": { "type": "integer", "minimum": 0 },
    "changed_component_count": { "type": "integer", "minimum": 0 },
    "unmapped_changed_file_count": { "type": "integer", "minimum": 0 },
    "mapping_coverage": { "type": ["string", "null"] },
    "mapping_coverage_status": { "type": "string" },
    "boundary_dimension": { "type": ["string", "null"] },
    "boundary_spread_member_ids": { "type": "array" },
    "boundary_spread_count": { "type": ["integer", "null"] },
    "boundary_spread_status": { "type": "string" },
    "crossed_boundary_count": { "type": ["integer", "null"] },
    "crossed_boundary_pairs": { "type": "array" },
    "crossed_boundary_status": { "type": "string" },
    "affected_component_ids": { "type": "array" },
    "affected_component_count": { "type": ["integer", "null"] },
    "affected_test_ids": { "type": "array" },
    "affected_test_count": { "type": ["integer", "null"] },
    "visited_nodes": { "type": ["integer", "null"] },
    "visited_edges": { "type": ["integer", "null"] },
    "cutoff_reason": { "type": ["string", "null"] },
    "graph_side": { "type": "string" },
    "lower_bound": { "type": "boolean" },
    "narrative_only_context": { "type": "boolean" }
  }
}
