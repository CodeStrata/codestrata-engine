{
  "catalog_id": "codestrata-privacy-first-telemetry-catalog",
  "catalog_policy_version": "1.0",
  "change_policy": [
    "catalog_artifact_update_required",
    "code_change_required",
    "privacy_review_required",
    "runtime_event_schema_remains_1_0_unless_serialized_event_changes",
    "schema_or_policy_version_review_required",
    "tests_required"
  ],
  "client_name": "codestrata_cli",
  "consent_expands_fields": false,
  "consent_persistence": "none",
  "consent_scope": "session",
  "cross_field_rules": [
    {
      "description": "client_name must equal codestrata_cli; other clients are rejected.",
      "rule_id": "client_name_fixed"
    },
    {
      "description": "Session consent cannot expand the approved field set or bypass projection.",
      "rule_id": "consent_cannot_expand_fields"
    },
    {
      "description": "enabled_assessment_heads is omitted from intake when empty.",
      "rule_id": "empty_heads_omitted"
    },
    {
      "description": "Privacy projection always injects schema_version and runtime_policy_version onto the privacy-safe payload.",
      "rule_id": "projection_injects_versions"
    },
    {
      "description": "The current privacy-first runtime applies one shared typed event shape to all event types. Event-specific requiredness beyond event_type and client_name is not enforced by validators today.",
      "rule_id": "shared_event_shape"
    },
    {
      "description": "Unknown enum values are rejected (no silent forward compatibility).",
      "rule_id": "unknown_enum_rejected"
    }
  ],
